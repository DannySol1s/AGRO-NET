# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Dependencias ──────────────────────────────────────────────────────
node_modules/

# ── Variables de entorno (NUNCA subir claves al repo) ─────────────────
.env
.env.*
# Excepción: el archivo de ejemplo SÍ va al repo (sin valores reales)
!.env.example

# ── Expo ──────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Carpetas nativas generadas ────────────────────────────────────────
/ios
/android
.kotlin/

# ── Certificados y claves privadas ───────────────────────────────────
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── Metro / caché ────────────────────────────────────────────────────
.metro-health-check*

# ── Logs de debug ────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ── Sistema operativo ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── TypeScript ───────────────────────────────────────────────────────
*.tsbuildinfo

# ── Base de datos local (no compartir datos del dispositivo) ─────────
*.sqlite
*.sqlite3
*.db

# ── Claude Code (estado interno, no es código del proyecto) ──────────
.claude/
